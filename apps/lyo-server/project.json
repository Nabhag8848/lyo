{
  "name": "@lyo/lyo-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/lyo-server/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "webpack-cli build",
        "cwd": "apps/lyo-server"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"],
          "envFile": "apps/lyo-server/.env"
        },
        "production": {
          "args": ["--node-env=production"],
          "envFile": "apps/lyo-server/.env.production"
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/apps/lyo-server/dist/package.json",
        "{workspaceRoot}/apps/lyo-server/dist/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/apps/lyo-server/dist/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "@lyo/lyo-server:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "@lyo/lyo-server:build:development"
        },
        "production": {
          "buildTarget": "@lyo/lyo-server:build:production"
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "migration:deploy": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "typeorm-ts-node-commonjs migration:run -d src/database/datasource/app.datasource.ts",
        "cwd": "apps/lyo-server"
      },
      "configurations": {
        "development": {
          "envFile": "apps/lyo-server/.env"
        },
        "production": {
          "envFile": "apps/lyo-server/.env.production"
        }
      }
    },
    "migration:revert": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "typeorm-ts-node-commonjs migration:revert -d src/database/datasource/app.datasource.ts",
        "cwd": "apps/lyo-server"
      },
      "configurations": {
        "development": {
          "envFile": "apps/lyo-server/.env"
        },
        "production": {
          "envFile": "apps/lyo-server/.env.production"
        }
      }
    },
    "migration:generate": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "typeorm-ts-node-commonjs migration:generate src/database/migrations/{args.name} -d src/database/datasource/app.datasource.ts",
        "cwd": "apps/lyo-server"
      },
      "configurations": {
        "development": {
          "envFile": "apps/lyo-server/.env"
        },
        "production": {
          "envFile": "apps/lyo-server/.env.production"
        }
      }
    },
    "migration:create": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "typeorm-ts-node-commonjs migration:create src/database/migrations/{args.name}",
        "cwd": "apps/lyo-server"
      },
      "configurations": {
        "development": {
          "envFile": "apps/lyo-server/.env"
        },
        "production": {
          "envFile": "apps/lyo-server/.env.production"
        }
      }
    },
    "migration:show": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "typeorm-ts-node-commonjs migration:show -d src/database/datasource/app.datasource.ts",
        "cwd": "apps/lyo-server"
      },
      "configurations": {
        "development": {
          "envFile": "apps/lyo-server/.env"
        },
        "production": {
          "envFile": "apps/lyo-server/.env.production"
        }
      }
    },
    "migration:schema:sync": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "typeorm-ts-node-commonjs schema:sync -d src/database/datasource/app.datasource.ts",
        "cwd": "apps/lyo-server"
      },
      "configurations": {
        "development": {
          "envFile": "apps/lyo-server/.env"
        },
        "production": {
          "envFile": "apps/lyo-server/.env.production"
        }
      }
    }
  }
}
